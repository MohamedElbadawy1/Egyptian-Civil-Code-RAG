
# data (tracked by DVC instead) -- DVC manages its own .gitignore inside
# data/raw/ and data/processed/ once files are `dvc add`ed, ignoring the
# actual data files while letting .dvc pointer files stay git-tracked.
.env

# data (tracked by DVC instead) -- DVC manages its own .gitignore inside
# data/raw/ and data/processed/ once files are `dvc add`ed, ignoring the
# actual data files while letting .dvc pointer files stay git-tracked.
.env

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# MLflow local tracking store -- machine-specific, not shared via git
mlflow.db
mlruns/